<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">


        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/cancel"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_gravity="end"
            android:visibility="invisible"
            app:tint="@color/gnt_gray" />
        <!-- Top spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.50" />

        <!-- Icon -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/icon"
            android:elevation="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Get Premium Features"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Time Warp Filter"
            android:textSize="16sp"
            android:textColor="#B0B0B0"
            android:layout_marginTop="8dp" />

        <!-- Feature List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="120dp"
            android:layout_marginBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="✓"
                    android:textSize="18sp"
                    android:textColor="#4CAF50"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlimited Images"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="✓"
                    android:textSize="18sp"
                    android:textColor="#4CAF50"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Various Filters"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:text="✓"
                    android:textSize="18sp"
                    android:textColor="#4CAF50"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100% No Ads"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Trial Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3-DAY FREE TRIAL, auto-renewal."
            android:textSize="13sp"
            android:textColor="#B0B0B0"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Then $6.99/week, cancel anytime."
            android:textSize="13sp"
            android:textColor="#B0B0B0"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Start Free Trial Button -->
        <Button
            android:id="@+id/btnStartTrial"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Start Free Trial"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_button_gradient"
            android:elevation="2dp" />

        <!-- Plan Options -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2A2A4A"
                android:padding="16dp"
                android:layout_marginBottom="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yearly"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-renewal, cancel anytime."
                    android:textSize="12sp"
                    android:textColor="#B0B0B0"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$29.99"
                    android:textSize="16sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#2A2A4A"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lifetime"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="One-time payment."
                    android:textSize="12sp"
                    android:textColor="#B0B0B0"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$34.99"
                    android:textSize="16sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Footer Links -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/btnRestore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restore"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:padding="8dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#B0B0B0"
                android:layout_marginHorizontal="12dp" />

            <TextView
                android:id="@+id/btnPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:padding="8dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:background="#B0B0B0"
                android:layout_marginHorizontal="12dp" />

            <TextView
                android:id="@+id/btnTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terms of Use"
                android:textSize="13sp"
                android:textColor="#B0B0B0"
                android:padding="8dp" />

        </LinearLayout>

        <!-- Bottom spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>